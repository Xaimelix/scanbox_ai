# ScanBox AI — креденшелы Selectel для orchestrator.py
# Панель Selectel: Настройки → API-ключи / OpenStack.
# Экспортируй перед запуском:  set -a && source .env && set +a

SELECTEL_ACCOUNT_ID=
SELECTEL_USERNAME=
SELECTEL_PASSWORD=
SELECTEL_PROJECT_NAME=default

# Уточни в панели или через `openstack flavor list` / `openstack image list`
# SELECTEL_REGION=ru-1
# SELECTEL_FLAVOR=
# SELECTEL_IMAGE=

# GPU-серверы Selectel обычно грузятся с диска — укажи размер, напр. 200
SELECTEL_BOOT_VOLUME_GB=200

# Только для сметы в логе
SELECTEL_GPU_RATE=350